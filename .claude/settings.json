{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws s3 mv:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 sync:*)",
      "Bash(mc cp:*)",
      "Bash(mc mv:*)",
      "Bash(mc rm:*)",
      "Bash(mc mirror:*)",
      "Bash(uv run scripts/export_predictions.py:*)",
      "Bash(launchers/launch_eval.sh:*)",
      "Bash(pkill:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./data/**)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
